{
  "name": "quiz-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply quiz_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply quiz_db --remote",
    "db:create": "wrangler d1 create quiz_db",
    "typecheck": "astro check"
  },
  "dependencies": {
    "astro": "^5.13.0",
    "hono": "^4.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@astrojs/cloudflare": "^12.6.0",
    "@tailwindcss/vite": "^4.1.0",
    "@cloudflare/workers-types": "^4.20250620.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "wrangler": "^3.114.0"
  }
}
