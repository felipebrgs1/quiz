---
import Quiz from "../components/Quiz.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Quiz — Descubra se você tem direito</title>
    <meta name="description" content="Responda 6 perguntas rápidas e descubra se você pode ter direito ao benefício." />
  </head>
  <body class="min-h-screen bg-[linear-gradient(180deg,#000000_0%,#131007_45%,#000000_100%)] text-white antialiased">
    <div class="mx-auto flex min-h-screen w-full max-w-3xl flex-col px-3 py-4 sm:px-8 sm:py-6">
      <header class="flex items-center justify-center gap-2 py-3 sm:py-5">
        {/* troque pelo seu logo em public/logo.png */}
        <span class="flex size-9 items-center justify-center rounded-xl bg-orange-600 font-black text-white shadow-lg shadow-orange-600/40">M</span>
        <span class="text-sm font-bold tracking-wide text-zinc-200">MOTA E SILVA <span class="text-orange-400">ADVOGADOS</span></span>
      </header>

      <main class="flex flex-1 items-center justify-center py-2 sm:py-8">
        <Quiz />
      </main>

      <footer class="mt-5 rounded-2xl border border-zinc-800 bg-zinc-950/80 px-4 py-4 text-xs text-zinc-400 sm:mt-6 sm:flex sm:items-center sm:justify-between sm:rounded-3xl sm:px-5 sm:text-sm">
        <p>© 2026 Mota e Silva Advogados. Todos os direitos reservados.</p>
        <a href="/resultado" class="mt-3 inline-flex font-semibold text-orange-300 underline-offset-4 hover:underline sm:mt-0">
          Política de privacidade
        </a>
      </footer>
    </div>
  </body>
</html>
