---
import Quiz from "../components/Quiz.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#09090b" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>Quiz — Descubra se você tem direito</title>
    <meta name="description" content="Responda 6 perguntas rápidas e descubra se você pode ter direito ao benefício." />
  </head>
  <body class="bg-zinc-950 text-white">
    <div class="mx-auto flex min-h-dvh w-full max-w-md flex-col px-5">
      <header class="flex items-center justify-center gap-4 py-5">
        <img src="/msa-logo.webp" alt="" width="430" height="122" class="h-auto w-24 shrink-0 object-contain mix-blend-screen" />
        <span class="flex flex-col gap-1 border-l border-white/15 pl-4">
          <span class="text-xs font-semibold leading-none tracking-[0.12em] text-zinc-200">MOTA E SILVA</span>
          <span class="text-[10px] font-medium leading-none tracking-[0.24em] text-orange-400">ADVOGADOS</span>
        </span>
      </header>

      <main class="flex flex-1 flex-col">
        <Quiz />
      </main>

      <footer class="py-4 text-center text-[11px] leading-relaxed text-zinc-600">
        © 2026 Mota e Silva Advogados · <a href="/privacidade" class="underline underline-offset-2 transition hover:text-zinc-400">Privacidade</a>
      </footer>
    </div>
  </body>
</html>
