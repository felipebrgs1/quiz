---
import "../styles/global.css";

const qualified = Astro.url.searchParams.get("qualified") === "1";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Resultado — Análise registrada</title>
  </head>
  <body class="flex min-h-screen items-center justify-center bg-[linear-gradient(180deg,#000000_0%,#131007_50%,#000000_100%)] px-4 py-8 text-white">
    <section class="w-full max-w-xl rounded-3xl border border-zinc-800 bg-zinc-950 p-5 shadow-2xl shadow-black/60 ring-1 ring-orange-500/10 sm:p-8 md:p-10">
      <p class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-[0.24em] text-emerald-300">
        <span class="flex size-4 items-center justify-center rounded-full bg-emerald-900">
          <svg viewBox="0 0 24 24" class="size-2.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
        </span>
        Análise concluída
      </p>
      <h1 class="mt-4 text-2xl font-semibold sm:text-3xl">
        {qualified ? "Pré-análise aprovada! 🎉" : "Sua análise foi registrada."}
      </h1>
      <p class="mt-3 text-sm leading-6 text-zinc-300 sm:text-base">
        {qualified
          ? "Seu perfil passou na triagem inicial. Nossa equipe jurídica vai revisar e te chamar no WhatsApp."
          : "Recebemos suas respostas. Nossa equipe poderá revisar as informações e dar continuidade pelos canais informados."}
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/" class="inline-flex h-12 flex-1 items-center justify-center rounded-full bg-orange-600 px-6 text-sm font-semibold text-white shadow-lg shadow-orange-600/30 transition hover:-translate-y-0.5 hover:bg-orange-500">
          Fazer nova análise
        </a>
      </div>
    </section>
  </body>
</html>
