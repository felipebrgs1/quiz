---
import "../styles/global.css";
import { TIERS, bottleneckText, type TierId } from "../lib/quiz";

type LeadRow = {
  id: string;
  name: string;
  score_total: number;
  tier: string;
  bottleneck_json: string;
};

const leadId = Astro.url.searchParams.get("leadId");

let lead: LeadRow | null = null;
try {
  const env = (Astro.locals as unknown as { runtime?: { env?: { DB?: D1Database } } }).runtime?.env;
  if (leadId && env?.DB) {
    lead = await env.DB.prepare(
      "SELECT id, name, score_total, tier, bottleneck_json FROM leads WHERE id = ?"
    ).bind(leadId).first<LeadRow>();
  }
} catch {}

const tier = lead && lead.tier in TIERS ? TIERS[lead.tier as TierId] : null;
const bottleneck: string[] = lead ? JSON.parse(lead.bottleneck_json ?? "[]") : [];
const firstName = lead?.name.split(" ")[0] ?? "";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#09090b" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>Resultado — Raio-X do seu escritório</title>
  </head>
  <body class="bg-zinc-950 text-white">
    <div class="mx-auto flex min-h-dvh w-full max-w-md flex-col px-4 py-6 min-[375px]:px-5 min-[375px]:py-8">
      <header class="flex items-center justify-center gap-4">
        <img src="/msa-logo.webp" alt="" width="430" height="122" class="h-auto w-24 shrink-0 object-contain mix-blend-screen" />
        <span class="flex flex-col gap-1 border-l border-white/15 pl-4">
          <span class="text-xs font-semibold leading-none tracking-[0.12em] text-zinc-200">MOTA E SILVA</span>
          <span class="text-[10px] font-medium leading-none tracking-[0.24em] text-orange-400">ADVOGADOS</span>
        </span>
      </header>

      {lead && tier ? (
        <main class="flex flex-1 flex-col justify-center py-8 text-center">
          <p class="inline-flex items-center gap-1.5 self-center rounded-full border border-orange-500/30 bg-orange-500/10 px-3 py-1 text-[11px] font-semibold tracking-wide text-orange-300">
            ESTÁGIO {tier.stage} DE 4
          </p>
          <p class="mt-4 text-balance text-[11px] font-semibold uppercase tracking-[0.12em] text-zinc-500 [overflow-wrap:anywhere]">
            {firstName ? `${firstName}, seu` : "Seu"} Raio-X está pronto
          </p>
          <h1 class="mt-2 text-balance text-[28px] font-semibold leading-tight tracking-tight text-zinc-50 min-[375px]:text-3xl">
            {tier.name}
          </h1>
          <p class="mx-auto mt-2 text-sm font-medium tabular-nums text-orange-400">
            Você fez {lead.score_total} de 20 pontos
          </p>
          <p class="mx-auto mt-2 max-w-[38ch] text-pretty text-[15px] leading-relaxed text-zinc-400">
            {tier.description}
          </p>

          <div class="mt-6 rounded-2xl border border-orange-500/25 bg-orange-500/[0.06] p-4 text-left min-[375px]:p-5">
            <p class="text-balance text-[11px] font-semibold uppercase tracking-[0.12em] text-orange-400">
              Seu maior gargalo agora é
            </p>
            <p class="mt-1.5 text-balance text-lg font-semibold leading-snug text-zinc-50">
              {bottleneckText(bottleneck)}
            </p>
          </div>

          <section class="mt-6 rounded-2xl border border-white/10 bg-white/[0.03] p-4 text-left min-[375px]:p-5" aria-labelledby="next-step-title">
            <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-orange-400">Seu próximo passo</p>
            <h2 id="next-step-title" class="mt-2 text-balance text-xl font-semibold leading-snug text-zinc-50">
              Vamos conversar sobre seu resultado?
            </h2>
            <p class="mt-3 text-pretty text-sm leading-relaxed text-zinc-300">
              Entenda seu gargalo com a MSA e descubra os próximos passos para o seu escritório.
            </p>
            <a
              href={`https://wa.me/5599984472044?text=${encodeURIComponent("Olá! Fiz o Raio-X do meu escritório e gostaria de conversar com a MSA sobre meu resultado.")}`}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-5 flex min-h-[52px] w-full items-center justify-center rounded-2xl bg-orange-500 px-4 py-3 text-center text-[15px] font-semibold text-white shadow-[0_12px_30px_-10px_rgba(249,115,22,0.6)] transition hover:bg-orange-400 active:scale-[0.99] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-orange-400"
            >
              Conversar com a MSA
            </a>
            <p class="mt-2 flex flex-wrap justify-center gap-x-1.5 gap-y-1 text-center text-xs text-zinc-400">
              <span>WhatsApp</span>
              <span class="whitespace-nowrap">(99) 98447-2044</span>
            </p>
            <a
              href="https://www.instagram.com/motaesilva.adv/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Visitar o Instagram da Mota e Silva Advogados (abre em nova aba)"
              class="group mt-4 block overflow-hidden rounded-2xl border border-white/15 bg-zinc-950/50 text-left transition hover:border-orange-400/40 hover:bg-white/[0.04] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-orange-400"
            >
              <div class="flex items-center gap-2 border-b border-white/10 px-4 py-2.5 text-xs font-medium text-zinc-400">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                </svg>
                Instagram
              </div>
              <div class="flex items-center gap-3 px-4 py-4">
                <div class="shrink-0 rounded-full bg-gradient-to-tr from-orange-400 via-pink-500 to-purple-500 p-[2px]">
                  <div class="flex size-14 items-center justify-center rounded-full border-[3px] border-zinc-950 bg-zinc-900">
                    <img src="/msa-logo.webp" alt="" width="430" height="122" loading="lazy" class="h-auto w-10 object-contain mix-blend-screen" />
                  </div>
                </div>
                <div class="min-w-0">
                  <p class="text-pretty text-sm font-semibold leading-snug text-zinc-100">Mota e Silva Advogados</p>
                  <p class="mt-1 text-xs leading-relaxed text-zinc-400 [overflow-wrap:anywhere]">@motaesilva.adv</p>
                </div>
              </div>
              <div class="flex min-h-[44px] items-center justify-between gap-3 border-t border-white/10 px-4 py-3 text-sm font-semibold text-orange-300 transition group-hover:text-orange-200">
                <span>Ver perfil no Instagram</span>
                <svg aria-hidden="true" class="shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 17 17 7M7 7h10v10" />
                </svg>
              </div>
            </a>
            <p class="mt-3 text-pretty text-sm leading-relaxed text-zinc-400">
              Está no evento? Converse gratuitamente com um dos sócios no nosso estande.
            </p>
          </section>

          <a href="/" class="mt-5 inline-flex min-h-[44px] items-center justify-center self-center rounded-lg px-4 text-sm font-medium text-zinc-400 underline decoration-zinc-700 underline-offset-4 transition hover:text-zinc-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-orange-400">
            Refazer diagnóstico
          </a>
        </main>
      ) : (
        <main class="flex flex-1 flex-col items-center justify-center py-8 text-center">
          <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-zinc-500">Resultado não encontrado</p>
          <h1 class="mt-2 text-balance text-2xl font-semibold leading-snug tracking-tight text-zinc-50">
            Não encontramos seu diagnóstico
          </h1>
          <p class="mt-2 max-w-[36ch] text-pretty text-sm leading-relaxed text-zinc-400">
            O link pode ter expirado. Refaça o diagnóstico — leva menos de 1 minuto.
          </p>
          <a href="/" class="mt-7 flex h-[52px] w-full items-center justify-center rounded-2xl bg-orange-500 text-[15px] font-semibold text-white shadow-[0_12px_30px_-10px_rgba(249,115,22,0.6)] transition hover:bg-orange-400 active:scale-[0.99]">
            Fazer meu diagnóstico
          </a>
        </main>
      )}

      <footer class="py-4 text-center text-[11px] leading-relaxed text-zinc-600">
        © 2026 Mota e Silva Advogados
      </footer>
    </div>
  </body>
</html>
