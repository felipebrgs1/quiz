---
import { leadCapture, quizIntro, quizQuestions } from "../lib/quiz";

const totalQ = quizQuestions.length;
const totalSteps = totalQ + 3;
---

<div id="quiz" class="flex flex-1 flex-col">
  <!-- indicador de progresso -->
  <div id="quiz-progress" hidden class="sticky top-0 z-10 -mx-5 bg-zinc-950/40 px-5 py-3 backdrop-blur-md">
    <div class="py-1">
      <div class="flex items-center justify-between gap-3">
        <button id="quiz-back" type="button" class="-ml-2 flex min-h-11 items-center gap-1.5 rounded-lg px-2 text-xs font-medium text-zinc-400 transition hover:bg-white/5 hover:text-white active:scale-95">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
          Voltar
      </button>
        <p id="quiz-counter" aria-live="polite" aria-atomic="true" class="text-xs font-semibold tabular-nums text-zinc-200"></p>
      </div>
      <ol aria-label="Etapas da análise" class="mt-2 grid grid-cols-3 gap-3">
        {["Perguntas", "Contato", "Revisão"].map((label, index) => (
          <li data-phase={index} class="quiz-phase">
            <div aria-hidden="true" class="h-1 overflow-hidden rounded-full bg-white/10">
              <div class="quiz-phase-fill h-full rounded-full bg-orange-400"></div>
            </div>
            <span class="mt-2 flex items-center gap-1.5 text-[11px] font-medium">
              <span class="quiz-phase-number flex size-4 shrink-0 items-center justify-center rounded-full text-[9px]">{index + 1}</span>
              {label}
            </span>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <!-- conteúdo -->
  <div class="flex flex-1 flex-col py-6">
    <!-- 0: intro -->
    <div data-panel="0" class="flex flex-1 flex-col justify-center py-4 text-center">
      <p class="inline-flex items-center gap-1.5 self-center rounded-full border border-white/10 bg-white/5 px-3 py-1 text-[11px] font-medium text-zinc-300">
        <span class="flex items-center gap-0.5 text-amber-400" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="size-3" fill="currentColor"><path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4 6.1 20.5l1.2-6.5L2.5 9.4l6.6-.9z"/></svg>
          <svg viewBox="0 0 24 24" class="size-3" fill="currentColor"><path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4 6.1 20.5l1.2-6.5L2.5 9.4l6.6-.9z"/></svg>
          <svg viewBox="0 0 24 24" class="size-3" fill="currentColor"><path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4 6.1 20.5l1.2-6.5L2.5 9.4l6.6-.9z"/></svg>
          <svg viewBox="0 0 24 24" class="size-3" fill="currentColor"><path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4 6.1 20.5l1.2-6.5L2.5 9.4l6.6-.9z"/></svg>
          <svg viewBox="0 0 24 24" class="size-3" fill="currentColor"><path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4 6.1 20.5l1.2-6.5L2.5 9.4l6.6-.9z"/></svg>
        </span>
        {quizIntro.seal}
      </p>
      <h1 class="mt-5 text-balance text-[27px] font-semibold leading-[1.18] tracking-tight text-zinc-50">{quizIntro.title}</h1>
      <p class="mx-auto mt-3 max-w-[34ch] text-pretty text-[15px] leading-relaxed text-zinc-400">{quizIntro.text}</p>
      <ul class="mx-auto mt-6 space-y-2.5 text-left text-sm text-zinc-300">
        <li class="flex items-center gap-2.5">
          <svg viewBox="0 0 24 24" class="size-4 shrink-0 text-orange-500" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
          Leva menos de 1 minuto
        </li>
        <li class="flex items-center gap-2.5">
          <svg viewBox="0 0 24 24" class="size-4 shrink-0 text-orange-500" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
          Análise 100% gratuita
        </li>
        <li class="flex items-center gap-2.5">
          <svg viewBox="0 0 24 24" class="size-4 shrink-0 text-orange-500" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
          Sem compromisso
        </li>
      </ul>
    </div>

    <!-- perguntas -->
    {quizQuestions.map((q, i) => (
      <div data-panel={i + 1} hidden class="flex flex-col">
        <h2 id={`question-${q.id}`} class="text-balance text-[22px] font-semibold leading-snug tracking-tight text-zinc-50">{q.title}</h2>
        {q.subtitle && <p class="mt-1.5 text-sm leading-relaxed text-zinc-400">{q.subtitle}</p>}
        <div role="group" aria-labelledby={`question-${q.id}`} class="mt-5 grid gap-1">
          {q.options.map((opt) => (
            <button
              type="button"
              class="quiz-opt flex min-h-16 w-full cursor-pointer items-center gap-4 border-b border-white/10 px-3 py-4 text-left text-[15px] font-medium leading-relaxed text-zinc-300"
              aria-pressed="false"
              data-q={q.id}
              data-value={opt.value}
            >
              <span class="flex-1">{opt.label}</span>
              <span class="quiz-dot flex size-5 shrink-0 items-center justify-center rounded-full border border-zinc-600 text-zinc-950" aria-hidden="true">
                <svg viewBox="0 0 24 24" class="size-3" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
              </span>
            </button>
          ))}
        </div>
      </div>
    ))}

    <!-- contato -->
    <div data-panel={totalQ + 1} hidden class="flex flex-col">
      <p class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-[0.18em] text-emerald-400">
        <span class="size-1.5 rounded-full bg-emerald-400"></span>
        Análise quase pronta
      </p>
      <h2 class="mt-2 text-balance text-[22px] font-semibold leading-snug tracking-tight text-zinc-50">{leadCapture.title}</h2>
      <p class="mt-1.5 text-sm leading-relaxed text-zinc-400">{leadCapture.subtitle}</p>
      <div class="mt-5 grid gap-4">
        <label class="grid gap-1.5 text-[13px] font-medium text-zinc-300">
          Nome
          <input id="quiz-name" placeholder="Seu nome completo" autocomplete="name" class="h-[52px] rounded-2xl border border-white/10 bg-white/[0.03] px-4 text-base font-normal text-zinc-50 outline-none transition placeholder:text-zinc-600 focus:border-orange-500/70 focus:bg-orange-500/[0.04]" />
        </label>
        <label class="grid gap-1.5 text-[13px] font-medium text-zinc-300">
          Telefone
          <input id="quiz-phone" placeholder="(00) 00000-0000" autocomplete="tel" inputmode="tel" class="h-[52px] rounded-2xl border border-white/10 bg-white/[0.03] px-4 text-base font-normal text-zinc-50 outline-none transition placeholder:text-zinc-600 focus:border-orange-500/70 focus:bg-orange-500/[0.04]" />
        </label>
      </div>
    </div>

    <!-- revisão -->
    <div data-panel={totalQ + 2} hidden class="flex flex-col">
      <h2 class="text-balance text-[22px] font-semibold leading-snug tracking-tight text-zinc-50">Confira seus dados</h2>
      <p class="mt-1.5 text-sm leading-relaxed text-zinc-400">Falta só confirmar para concluir a análise.</p>
      <div class="mt-5 rounded-2xl border border-orange-500/20 bg-orange-500/[0.05] p-4">
        <div class="flex items-start justify-between gap-3">
          <div class="space-y-1 text-sm">
            <p class="text-zinc-400">Nome <span id="quiz-review-name" class="font-medium text-zinc-100"></span></p>
            <p class="text-zinc-400">Telefone <span id="quiz-review-phone" class="font-medium text-zinc-100"></span></p>
          </div>
          <button type="button" data-edit class="shrink-0 rounded-lg px-2.5 py-1.5 text-[13px] font-medium text-orange-400 transition hover:bg-orange-500/10 hover:text-orange-300">
            Editar
          </button>
        </div>
      </div>
      <p id="quiz-error" hidden class="mt-3 rounded-2xl border border-red-500/25 bg-red-500/10 p-3 text-[13px] leading-relaxed text-red-300"></p>
    </div>
  </div>

  <!-- CTA fixo -->
  <div class="sticky bottom-0 -mx-5 bg-zinc-950/40 px-5 pb-[max(1.25rem,env(safe-area-inset-bottom))] pt-5 backdrop-blur-md">
    <button id="quiz-primary" type="button" class="flex h-[52px] w-full items-center justify-center gap-2 rounded-2xl bg-orange-500 text-[15px] font-semibold text-white shadow-[0_12px_30px_-10px_rgba(249,115,22,0.6)] transition hover:bg-orange-400 active:scale-[0.99] disabled:bg-white/10 disabled:text-zinc-500 disabled:shadow-none"></button>
  </div>
</div>

<style>
  .quiz-phase {
    color: #71717a;
  }
  .quiz-phase-fill {
    width: var(--phase-progress, 0%);
    transition: width 0.3s ease;
  }
  .quiz-phase-number {
    background: rgb(255 255 255 / 0.06);
  }
  .quiz-phase[aria-current="step"] {
    color: #fb923c;
  }
  .quiz-phase[aria-current="step"] .quiz-phase-number {
    background: rgb(251 146 60 / 0.15);
  }
  .quiz-phase[data-complete="true"] {
    color: #d4d4d8;
  }
  .quiz-opt,
  .quiz-dot {
    transition: background-color 0.18s ease, border-color 0.18s ease, color 0.18s ease;
  }
  .quiz-dot svg {
    opacity: 0;
    transform: scale(0.7);
    transition: opacity 0.18s ease, transform 0.18s ease;
  }
  .quiz-opt[data-selected="true"] {
    border-color: rgb(249 115 22 / 0.6);
    background: rgb(249 115 22 / 0.06);
    color: #fdba74;
  }
  .quiz-opt[data-selected="true"] .quiz-dot {
    border-color: #fb923c;
    background: #fb923c;
  }
  .quiz-opt[data-selected="true"] .quiz-dot svg {
    opacity: 1;
    transform: scale(1);
  }
  .quiz-opt:active {
    background: rgb(249 115 22 / 0.1);
  }
  @media (hover: hover) {
    .quiz-opt:not([data-selected="true"]):hover {
      border-color: rgb(255 255 255 / 0.25);
      background: rgb(255 255 255 / 0.03);
      color: #fafafa;
    }
    .quiz-opt:hover .quiz-dot {
      border-color: #fb923c;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .quiz-phase-fill,
    .quiz-opt,
    .quiz-dot,
    .quiz-dot svg {
      transition: none;
    }
  }
</style>

<script define:vars={{ totalQ, totalSteps, introButton: quizIntro.button }}>
  const root = document.getElementById("quiz");
  const progressHeader = document.getElementById("quiz-progress");
  const phases = [...root.querySelectorAll("[data-phase]")];
  const counter = document.getElementById("quiz-counter");
  const backBtn = document.getElementById("quiz-back");
  const primary = document.getElementById("quiz-primary");
  const panels = [...root.querySelectorAll("[data-panel]")];
  const nameInput = document.getElementById("quiz-name");
  const phoneInput = document.getElementById("quiz-phone");
  const errorBox = document.getElementById("quiz-error");

  const ARROW = `<svg viewBox="0 0 24 24" class="size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;

  let step = 0;
  let answers = {};
  let timer = null;
  const seen = new Set();
  const submissionId = crypto.randomUUID();

  const meta = (() => {
    const params = new URLSearchParams(location.search);
    const utm = {};
    for (const [k, v] of params.entries()) {
      if (k.startsWith("utm_") || k === "gclid" || k === "fbclid") utm[k] = v;
    }
    const stored = (key, storageName) => {
      const id = crypto.randomUUID();
      try {
        const storage = window[storageName];
        const ex = storage.getItem(key);
        if (ex) return ex;
        storage.setItem(key, id);
      } catch {}
      return id;
    };
    return {
      anonymousId: stored("quiz_anon_id", "localStorage"),
      sessionId: stored("quiz_sess_id", "sessionStorage"),
      utm,
      sourceUrl: location.href,
      referrer: document.referrer,
    };
  })();

  async function track(eventName, extra = {}) {
    try {
      await fetch("/api/track", {
        method: "POST",
        keepalive: true,
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          eventName,
          ...extra,
          anonymousId: meta.anonymousId,
          sessionId: meta.sessionId,
          utm: meta.utm,
          referrer: meta.referrer,
          sourceUrl: meta.sourceUrl,
        }),
      });
    } catch {}
  }

  function maskPhone(v) {
    const d = v.replace(/\D/g, "").slice(0, 11);
    if (d.length <= 10) {
      const m = d.match(/(\d{0,2})(\d{0,4})(\d{0,4})/);
      return [`${m[1] ? `(${m[1]}` : ""}`, `${m[1]?.length === 2 ? ") " : ""}`, m[2], m[3] ? `-${m[3]}` : ""].join("");
    }
    const m = d.match(/(\d{0,2})(\d{0,5})(\d{0,4})/);
    return [`${m[1] ? `(${m[1]}` : ""}`, `${m[1]?.length === 2 ? ") " : ""}`, m[2], m[3] ? `-${m[3]}` : ""].join("");
  }

  function canStart() {
    return nameInput.value.trim().length >= 2 && phoneInput.value.replace(/\D/g, "").length >= 10;
  }

  function currentQid() {
    return panels[step]?.querySelector("[data-q]")?.dataset.q ?? null;
  }

  function go(n) {
    if (timer) { clearTimeout(timer); timer = null; }
    show(n);
  }

  function setPrimary(label, enabled, action, withArrow = true) {
    primary.innerHTML = withArrow ? `<span>${label}</span>${ARROW}` : `<span>${label}</span>`;
    primary.disabled = !enabled;
    primary.onclick = action;
  }

  function refreshChrome() {
    progressHeader.hidden = step === 0;
    const currentPhase = step <= totalQ ? 0 : step === totalQ + 1 ? 1 : 2;
    counter.textContent = step === 0 ? "" : step <= totalQ
      ? `Pergunta ${step} de ${totalQ}`
      : step === totalQ + 1 ? "Seus dados de contato" : "Confirme seus dados";
    phases.forEach((phase, index) => {
      const complete = index < currentPhase;
      phase.dataset.complete = String(complete);
      if (index === currentPhase) phase.setAttribute("aria-current", "step");
      else phase.removeAttribute("aria-current");
      const fill = complete ? 100 : index !== currentPhase || step === 0 ? 0
        : index === 0 ? (step / totalQ) * 100 : 50;
      phase.style.setProperty("--phase-progress", `${fill}%`);
    });

    if (step === 0) {
      setPrimary(introButton, true, () => {
        track("quiz_start", { quizStep: 0 });
        go(1);
      });
    } else if (step >= 1 && step <= totalQ) {
      const qid = currentQid();
      setPrimary("Continuar", !!qid && !!answers[qid], () => go(step + 1));
    } else if (step === totalQ + 1) {
      setPrimary("Continuar", canStart(), () => go(totalQ + 2));
    } else {
      setPrimary("Concluir análise", true, submit, false);
    }
  }

  function show(n) {
    step = Math.max(0, Math.min(totalSteps - 1, n));
    panels.forEach((p) => { p.hidden = Number(p.dataset.panel) !== step; });
    paintOptions();
    refreshChrome();
    if (!seen.has(step)) {
      seen.add(step);
      const progress = Math.round((step / (totalSteps - 1)) * 100);
      if (step === 0) track("page_view", { quizStep: 0 });
      else if (step >= 1 && step <= totalQ) {
        track("quiz_step_view", { quizStep: step, questionId: currentQid() });
      }
      else if (step === totalQ + 1) track("lead_form_view", { quizStep: step, progressPercent: progress });
    }
    if (step === totalQ + 2) {
      document.getElementById("quiz-review-name").textContent = nameInput.value;
      document.getElementById("quiz-review-phone").textContent = phoneInput.value;
    }
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  function paintOptions() {
    root.querySelectorAll(".quiz-opt").forEach((btn) => {
      const selected = answers[btn.dataset.q] === btn.dataset.value;
      btn.dataset.selected = selected ? "true" : "false";
      btn.setAttribute("aria-pressed", String(selected));
    });
  }

  root.querySelectorAll(".quiz-opt").forEach((btn) => {
    btn.addEventListener("click", () => {
      if (timer) return;
      answers = { ...answers, [btn.dataset.q]: btn.dataset.value };
      paintOptions();
      refreshChrome();
      track("quiz_answer", { quizStep: step, questionId: btn.dataset.q, metadata: { answer: btn.dataset.value } });
      timer = setTimeout(() => { timer = null; go(step + 1); }, 300);
    });
  });

  backBtn.addEventListener("click", () => go(step - 1));

  nameInput.addEventListener("input", refreshChrome);
  phoneInput.addEventListener("input", () => {
    phoneInput.value = maskPhone(phoneInput.value);
    refreshChrome();
  });

  root.querySelector("[data-edit]").addEventListener("click", () => go(totalQ + 1));

  async function submit() {
    errorBox.hidden = true;
    primary.disabled = true;
    primary.innerHTML = `<span>Enviando…</span>`;
    track("lead_submit_attempt", { quizStep: step, progressPercent: 100 });
    try {
      const res = await fetch("/api/lead", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ submissionId, name: nameInput.value, phone: phoneInput.value, answers, ...meta }),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.message ?? "Não foi possível concluir a análise.");
      track("lead_submit_success", { quizStep: step, progressPercent: 100, metadata: { tier: data.tier, score: data.score } });
      try { sessionStorage.removeItem("quiz_sess_id"); } catch {}
      location.href = data.redirectTo;
    } catch (e) {
      track("lead_submit_error", { quizStep: step });
      errorBox.textContent = e instanceof Error ? e.message : "Erro inesperado.";
      errorBox.hidden = false;
      refreshChrome();
    }
  }

  show(0);
</script>
